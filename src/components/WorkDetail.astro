---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatYears } from '../lib/content';

interface Props {
  entry: CollectionEntry<'projects' | 'products'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Base title={data.title} description={data.description}>
  <article>
    <h1>{data.title}</h1>
    <p>{data.description}</p>
    <dl class="muted">
      <dt>Years</dt><dd>{formatYears(data.start, data.end)}</dd>
      {data.role && (<><dt>Role</dt><dd>{data.role}</dd></>)}
      {data.client && (<><dt>Client</dt><dd>{data.client}</dd></>)}
      {data.platforms.length > 0 && (<><dt>Platforms</dt><dd>{data.platforms.join(', ')}</dd></>)}
      {data.stack.length > 0 && (<><dt>Stack</dt><dd>{data.stack.join(', ')}</dd></>)}
      {data.url && (<><dt>Website</dt><dd><a href={data.url}>{data.url}</a></dd></>)}
      {data.repo && (<><dt>Source</dt><dd><a href={data.repo}>{data.repo}</a></dd></>)}
    </dl>
    <Content />
  </article>
</Base>

<style>
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
  }
  dd {
    margin: 0;
  }
</style>
