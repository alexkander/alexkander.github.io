---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { formatRange, profile } from '../data/profile';
---

<Base title="CV" description={`CV of ${profile.name}, ${profile.title}.`}>
  <article class="cv">
    <header>
      <h1 class="name">{profile.name}</h1>
      <p class="muted">{profile.title}</p>
      <p class="contact">
        <a href={`mailto:${profile.email}`} aria-label="Email" title={profile.email}>
          <Icon name="mail" /><span class="label">{profile.email}</span>
        </a>
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
          <Icon name="github" /><span class="label">github.com/alexkander</span>
        </a>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
          <Icon name="linkedin" /><span class="label">linkedin.com/in/arondn2</span>
        </a>
        <a href="https://alexkander.dev" aria-label="Website" title="alexkander.dev">
          <Icon name="globe" /><span class="label">alexkander.dev</span>
        </a>
      </p>
    </header>

    <p>{profile.summary}</p>

    <section>
      <h2>Experience</h2>
      {
        profile.experience.map((role) => (
          <div class="entry">
            <h3>
              {role.title} · {role.company}
            </h3>
            <p class="muted">{formatRange(role.start, role.end)}</p>
            {role.highlights && (
              <ul>
                {role.highlights.map((h) => <li>{h}</li>)}
              </ul>
            )}
            {role.engagements?.map((e) => (
              <div class="engagement">
                <h4>
                  {e.name} <span class="muted">· {formatRange(e.start, e.end)}</span>
                </h4>
                <ul>
                  {e.highlights.map((h) => <li>{h}</li>)}
                </ul>
              </div>
            ))}
          </div>
        ))
      }
    </section>

    <section>
      <h2>Skills</h2>
      <dl>
        {
          profile.skills.map((s) => (
            <>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <section>
      <h2>Open source</h2>
      <ul>{profile.openSource.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section>
      <h2>Education</h2>
      {
        profile.education.map((e) => (
          <p>
            {e.degree} · {e.school} <span class="muted">· {e.start} – {e.end}</span>
          </p>
        ))
      }
      {
        profile.teaching.map((t) => (
          <p>
            {t.title} · {t.school} <span class="muted">· {formatRange(t.start, t.end)}</span>
          </p>
        ))
      }
    </section>

    <section>
      <h2>Interests</h2>
      <p>{profile.interests.join(' · ')}</p>
    </section>
  </article>
</Base>

<style>
  .cv h3 {
    margin-bottom: 0;
  }
  .cv h3 + .muted {
    margin-top: 0.2rem;
  }
  .cv h4 {
    margin: 0.75rem 0 0;
    font-weight: 500;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1rem;
  }
  .contact a {
    display: inline-flex;
    color: inherit;
  }
  .contact a:hover {
    color: var(--accent);
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
  }
  dt {
    font-weight: 500;
  }
  dd {
    margin: 0;
  }
  /* The site header already shows the name on screen; print hides it, so the PDF keeps this one. */
  /* Contact links are icons on screen, and spelled out in the PDF. */
  @media screen {
    .name,
    .contact .label {
      display: none;
    }
  }

  @media print {
    :global(.site-header),
    :global(.site-footer),
    .contact :global(.icon) {
      display: none;
    }
    :global(body) {
      background: #fff;
      color: #000;
      font-size: 10.5pt;
      line-height: 1.4;
    }
    :global(main) {
      max-width: none;
    }
    .entry {
      break-inside: avoid;
    }
  }
</style>
