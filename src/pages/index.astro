---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import WorkList from '../components/WorkList.astro';
import { profile } from '../data/profile';
import { getPublishedPosts, getWork } from '../lib/content';

const posts = (await getPublishedPosts()).slice(0, 5);
const projects = (await getWork('projects')).filter((p) => p.data.featured || p.data.status === 'active').slice(0, 5);
---

<Base>
  <section>
    <h1>{profile.name}</h1>
    <p>{profile.summary}</p>
  </section>

  <section>
    <h2>Latest posts</h2>
    <PostList posts={posts} />
    <a href="/posts/">All posts →</a>
  </section>

  {
    projects.length > 0 && (
      <section>
        <h2>Projects</h2>
        <WorkList entries={projects} base="/projects/" />
        <a href="/projects/">All projects →</a>
      </section>
    )
  }

  <section>
    <h2>Off the keyboard</h2>
    <p>{profile.interests.join(' · ')}</p>
  </section>
</Base>
