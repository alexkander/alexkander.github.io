---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Link from '../../components/Link.astro';
import { profile } from '../../data/profile';
import { formatDate, getPublishedPosts, licenses } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <p class="muted">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.updated && <> · updated {formatDate(post.data.updated)}</>}
    </p>
    {
      post.data.tags.length > 0 && (
        <ul class="tags muted">
          {post.data.tags.map((tag) => <li>#{tag}</li>)}
        </ul>
      )
    }
    <Content components={{ a: Link }} />
    <footer class="license muted">
      <p>
        © {post.data.date.getUTCFullYear()} {profile.name}. Unless noted otherwise, the text is licensed under{' '}
        <Link href={licenses.text.url} rel="license">{licenses.text.name}</Link> (share and adapt it with attribution, for
        non-commercial purposes), the code under <Link href={licenses.code.url} rel="license">{licenses.code.name}</Link>,
        and the photos under <Link href={licenses.photos.url} rel="license">{licenses.photos.name}</Link>. For any other
        use, <a href={`mailto:${profile.email}`}>ask me</a>.
      </p>
    </footer>
  </article>
</Base>

<style>
  .license {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
</style>
